@model IEnumerable<EduCore.Models.Entities.Section>
@{ ViewData["Title"] = "Gradebook"; ViewData["Active"] = "Gradebook"; }
<h1 class="h3 mb-3">Gradebook</h1>

@foreach (var s in Model)
{
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span class="fw-semibold">@s.GradeLevel.Name — @s.Name</span>
            <a asp-action="Attendance" asp-route-sectionId="@s.Id" class="btn btn-sm btn-outline-secondary">Attendance</a>
        </div>
        <ul class="list-group list-group-flush">
        @foreach (var ss in s.Subjects)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <div>@ss.Subject.FullName</div>
                    <div class="small text-body-secondary">@ss.Faculty.FullName</div>
                </div>
                <a asp-action="Grades" asp-route-sectionSubjectId="@ss.Id" class="btn btn-sm btn-primary">Enter grades</a>
            </li>
        }
        @if (!s.Subjects.Any())
        {
            <li class="list-group-item text-body-secondary">No subjects assigned. Set them up under <a asp-controller="Sections">Sections</a>.</li>
        }
        </ul>
    </div>
}
@if (!Model.Any()) { <p class="text-body-secondary">No sections available to you.</p> }