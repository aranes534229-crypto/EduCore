@model EduCore.Models.Entities.Section
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "New Section";
    var subjects = (List<EduCore.Models.Entities.Subject>?)ViewBag.Subjects ?? new();
}
<h1 class="h3 mb-4">New Section</h1>
<form asp-action="Create" method="post">
    <div class="ec-card p-4">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" placeholder="e.g. Grade 1 - B" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="GradeLevelId" class="form-label">Grade Level</label>
            <select asp-for="GradeLevelId" asp-items="ViewBag.GradeLevels" class="form-select"></select>
            <span asp-validation-for="GradeLevelId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="SchoolYearId" class="form-label">School Year</label>
            <select asp-for="SchoolYearId" asp-items="ViewBag.SchoolYears" class="form-select"></select>
            <span asp-validation-for="SchoolYearId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="AdviserId" class="form-label">Adviser</label>
            <select asp-for="AdviserId" asp-items="ViewBag.Advisers" class="form-select">
                <option value="">— none —</option>
            </select>
        </div>
        <div class="col-12">
            <label class="form-label">Subjects</label>
            @if (subjects.Count == 0)
            {
                <p class="text-body-secondary small">No subjects on file. Add subjects first (Admin → Subjects).</p>
            }
            else
            {
                <div class="row g-2">
                @foreach (var s in subjects)
                {
                    <div class="col-md-6 form-check">
                        <input class="form-check-input" type="checkbox" name="subjectIds" value="@s.Id" id="subj_@s.Id" />
                        <label class="form-check-label" for="subj_@s.Id">@s.FullName</label>
                    </div>
                }
                </div>
            }
        </div>
    </div>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>