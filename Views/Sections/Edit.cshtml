@model EduCore.Models.Entities.Section
@using EduCore.Models.Entities
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Edit Section";
    var subjects = (List<Subject>?)ViewBag.Subjects ?? new();
    var selected = (HashSet<int>?)ViewBag.SelectedSubjectIds ?? new HashSet<int>();
    var teachers = (List<Faculty>?)ViewBag.Teachers ?? new();
    var teacherOf = Model.Subjects.ToDictionary(ss => ss.SubjectId, ss => ss.FacultyId);
    var pool = (List<Student>?)ViewBag.Pool ?? new();
}
<h1 class="h3 mb-4">Edit Section — @Model.Name</h1>

<form asp-action="Edit" method="post">
    <div class="ec-card p-4">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" placeholder="e.g. Grade 1 - B" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="GradeLevelId" class="form-label">Grade Level</label>
            <select asp-for="GradeLevelId" asp-items="ViewBag.GradeLevels" class="form-select"></select>
            <span asp-validation-for="GradeLevelId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="SchoolYearId" class="form-label">School Year</label>
            <select asp-for="SchoolYearId" asp-items="ViewBag.SchoolYears" class="form-select"></select>
            <span asp-validation-for="SchoolYearId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="AdviserId" class="form-label">Adviser</label>
            <select asp-for="AdviserId" asp-items="ViewBag.Advisers" class="form-select">
                <option value="">— none —</option>
            </select>
        </div>
        <div class="col-12">
            <label class="form-label">Subjects &amp; teachers (teacher optional)</label>
            @if (subjects.Count == 0)
            {
                <p class="text-body-secondary small">No subjects on file. Add subjects first (Admin → Subjects).</p>
            }
            else
            {
                <table class="ec-table ec-table-sm">
                    <thead><tr><th style="width:2rem"></th><th>Subject</th><th>Teacher</th></tr></thead>
                    <tbody>
                    @foreach (var s in subjects)
                    {
                        var isSel = selected.Contains(s.Id);
                        var curT = isSel && teacherOf.TryGetValue(s.Id, out var t) ? t : (int?)null;
                        <tr>
                            <td>
                                <input class="form-check-input" type="checkbox" name="subjectIds" value="@s.Id"
                                       id="subj_@s.Id" checked="@isSel" />
                            </td>
                            <td><label class="form-check-label" for="subj_@s.Id">@s.FullName</label></td>
                            <td>
                                <select name="teacherIds[@s.Id]" class="form-select form-select-sm">
                                    <option value="">— none —</option>
                                    @foreach (var f in teachers)
                                    {
                                        <option value="@f.Id" selected="@(curT == f.Id)">@f.FullName</option>
                                    }
                                </select>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>
    </div>
    </div>
    <button type="submit" class="btn btn-primary">Save changes</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>

<div class="ec-card p-4 mt-4">
    <h2 class="h5">Students (@Model.Students.Count)</h2>
    <table class="ec-table ec-table-sm">
        <tbody>
        @foreach (var st in Model.Students.OrderBy(st => st.LastName))
        {
            <tr>
                <td>@st.FullName</td>
                <td class="text-end">
                    <form asp-action="RemoveStudent" asp-route-id="@Model.Id" asp-route-studentId="@st.Id"
                          method="post" class="d-inline">
                        <button class="btn btn-sm btn-outline-secondary">Unassign</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
    @if (!Model.Students.Any()) { <p class="text-body-secondary small">No students assigned.</p> }

    @if (pool.Count > 0)
    {
        <form asp-action="AssignStudent" asp-route-id="@Model.Id" method="post" class="row g-2 mt-2">
            <div class="col-auto">
                <label class="form-label small mb-1">Assign a student (not yet in a section)</label>
                <select name="studentId" asp-items="@(new SelectList(pool, "Id", "FullName"))" class="form-select form-select-sm"></select>
            </div>
            <div class="col-auto align-self-end"><button class="btn btn-sm btn-primary">Assign</button></div>
        </form>
    }
    else
    {
        <p class="text-body-secondary small">All students are placed in a section.</p>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}