@model SectionsIndexVM
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var isRegistrar = User.IsInRole("Registrar");
    ViewData["Title"] = isRegistrar ? "Class Schedule" : "Sections";
}

<!-- Title row -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@(isRegistrar ? "Class Schedule" : "Sections")</h1>
    @if (!isRegistrar)
    {
        <a asp-action="Create" class="btn btn-primary">New Section</a>
    }
</div>

<!-- Toolbar row -->
<form method="get" class="toolbar-row mb-3">
    <div class="toolbar-left">
        <!-- Search input with icon -->
        <div class="input-group" style="width: 280px;">
            <span class="input-group-text toolbar-input"><i class="bi bi-search"></i></span>
            <input type="search" name="q" class="form-control toolbar-input" placeholder="Search..." value="@Model.Search" />
        </div>

        <!-- Grade level filter -->
        <select name="gradeId" class="form-select form-select-sm toolbar-select" style="width: auto; min-width:150px;" onchange="this.form.submit();">
            <option value="">All grades</option>
            @foreach (var g in Model.GradeLevels)
            {
                <option value="@g.Value" selected="@(Model.GradeLevelId?.ToString() == g.Value)">@g.Text</option>
            }
        </select>

        <!-- School year filter -->
        <select name="schoolYearId" class="form-select form-select-sm toolbar-select" style="width: auto; min-width:150px;" onchange="this.form.submit();">
            <option value="">All school years</option>
            @foreach (var y in Model.SchoolYears)
            {
                <option value="@y.Value" selected="@(Model.SchoolYearId?.ToString() == y.Value)">@y.Text</option>
            }
        </select>

        <!-- Submitted filter -->
        <select name="isSubmitted" class="form-select form-select-sm toolbar-select" style="width: auto; min-width:150px;" onchange="this.form.submit();">
            <option value="">All statuses</option>
            <option value="true" selected="@(Model.IsSubmitted == true)">Submitted</option>
            <option value="false" selected="@(Model.IsSubmitted == false)">Not submitted</option>
        </select>
    </div>
</form>

<table class="ec-table">
    <thead>
        <tr>
            <th>Section</th>
            <th>Grade</th>
            <th>Adviser</th>
            <th>Subjects</th>
            <th>Students</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var s in Model.Items)
    {
        <tr>
            <td>
                <span class="fw-semibold">@s.Name</span>
                @if (s.IsSubmitted) { <span class="badge text-bg-success">Submitted</span> }
            </td>
            <td>@s.GradeLevel.Name</td>
            <td>@(s.Adviser?.FullName ?? "—")</td>
            <td>@s.Subjects.Count</td>
            <td>@s.Students.Count</td>
            <td class="text-end text-nowrap">
                @if (isRegistrar)
                {
                    <a asp-action="Schedule" asp-route-id="@s.Id" class="btn btn-sm btn-primary">Schedule</a>
                }
                @if (!isRegistrar)
                {
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-three-dots-vertical"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item" asp-controller="Gradebook" asp-action="Attendance" asp-route-sectionId="@s.Id">
                                    <i class="bi bi-clipboard-check me-2"></i> Attendance
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-action="Details" asp-route-id="@s.Id">
                                    <i class="bi bi-eye me-2"></i> View Details
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-action="Edit" asp-route-id="@s.Id">
                                    <i class="bi bi-pencil me-2"></i> Edit
                                </a>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline" data-confirm="Remove @s.Name? Students keep their records.">
                                    <button type="submit" class="dropdown-item text-danger" style="background:none; border:none; padding:0.25rem 1rem; text-align:left; width:100%;">
                                        <i class="bi bi-trash me-2"></i> Delete
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

@if (!Model.Items.Any())
{
    <p class="text-body-secondary text-center py-3">No sections yet. Create one.</p>
}
else
{
    <!-- Pagination footer -->
    <partial name="_PaginationFooter" model='new PaginationFooterVM
    {
        Action = "Index",
        Page = Model.Page,
        PageSize = Model.PageSize,
        TotalCount = Model.TotalCount,
        AriaLabel = "Sections pagination",
        RouteValues = new Dictionary<string, object?>
        {
            ["q"] = Model.Search,
            ["gradeId"] = Model.GradeLevelId,
            ["schoolYearId"] = Model.SchoolYearId,
            ["isSubmitted"] = Model.IsSubmitted
        }
    }' />
}
