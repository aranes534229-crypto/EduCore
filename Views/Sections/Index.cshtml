@model IEnumerable<EduCore.Models.Entities.Section>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var isRegistrar = User.IsInRole("Registrar");
    ViewData["Title"] = isRegistrar ? "Class Schedule" : "Sections";
    ViewData["Active"] = "Sections";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@(isRegistrar ? "Class Schedule" : "Sections")</h1>
    @if (!isRegistrar)
    {
        <a asp-action="Create" class="btn btn-primary">New Section</a>
    }
</div>

<table class="ec-table">
    <thead>
        <tr>
            <th>Section</th>
            <th>Grade</th>
            <th>Adviser</th>
            <th>Subjects</th>
            <th>Students</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var s in Model)
    {
        <tr>
            <td>
                @s.Name
                @if (s.IsSubmitted) { <span class="badge text-bg-success">Submitted</span> }
            </td>
            <td>@s.GradeLevel.Name</td>
            <td>@(s.Adviser?.FullName ?? "—")</td>
            <td>@s.Subjects.Count</td>
            <td>@s.Students.Count</td>
            <td class="text-end">
                @if (isRegistrar)
                {
                    <a asp-action="Schedule" asp-route-id="@s.Id" class="btn btn-sm btn-primary">Schedule</a>
                }
                @if (!isRegistrar)
                {
                    <a asp-controller="Gradebook" asp-action="Attendance" asp-route-sectionId="@s.Id"
                       class="btn btn-sm btn-outline-secondary">Attendance</a>
                }
                <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary">View</a>
                @if (!isRegistrar)
                {
                    <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Remove @s.Name? Students keep their records.');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
@if (!Model.Any()) { <p class="text-body-secondary">No sections yet. Create one.</p> }