@model IEnumerable<EduCore.Models.Entities.Section>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Sections";
    ViewData["Active"] = "Sections";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Sections</h1>
    <a asp-action="Create" class="btn btn-primary">New Section</a>
</div>

<table class="ec-table">
    <thead>
        <tr>
            <th>Section</th>
            <th>Grade</th>
            <th>Adviser</th>
            <th>Students</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var s in Model)
    {
        <tr>
            <td><a asp-action="Details" asp-route-id="@s.Id">@s.Name</a></td>
            <td>@s.GradeLevel.Name</td>
            <td>@(s.Adviser?.FullName ?? "—")</td>
            <td>@s.Students.Count</td>
            <td class="text-end">
                <a asp-controller="Gradebook" asp-action="Attendance" asp-route-sectionId="@s.Id"
                   class="btn btn-sm btn-outline-secondary">Attendance</a>
            </td>
        </tr>
    }
    </tbody>
</table>
@if (!Model.Any()) { <p class="text-body-secondary">No sections yet. Create one.</p> }