@model EduCore.Models.Entities.Enrollment
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Application details";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Application details</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
</div>

<div class="ec-card p-4">
    <div class="row mb-3">
        <div class="col-md-6">
            <h6 class="text-uppercase text-body-secondary">Student</h6>
            <p class="mb-1">@Model.Student.FullName</p>
            <p class="mb-0 text-body-secondary small">@Model.Student.StudentNumber</p>
        </div>
        <div class="col-md-6">
            <h6 class="text-uppercase text-body-secondary">Status</h6>
            <span class="badge @Model.StatusClass">@Model.Status</span>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-md-6">
            <h6 class="text-uppercase text-body-secondary">Applying for</h6>
            <p class="mb-0">@Model.GradeLevel.Name</p>
        </div>
        <div class="col-md-6">
            <h6 class="text-uppercase text-body-secondary">School year</h6>
            <p class="mb-0">@Model.SchoolYear.Name</p>
        </div>
    </div>
    <div>
        <h6 class="text-uppercase text-body-secondary">Applied</h6>
        <p class="mb-0">@Model.ApplicationDate.ToString("yyyy-MM-dd")</p>
    </div>
    @if (!string.IsNullOrEmpty(Model.Notes))
    {
        <div class="mt-3">
            <h6 class="text-uppercase text-body-secondary">Notes</h6>
            <p class="mb-0">@Model.Notes</p>
        </div>
    }
</div>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary mt-3">Edit</a>