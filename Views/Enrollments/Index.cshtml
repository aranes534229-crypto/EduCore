@using EduCore.Models.Entities
@using Microsoft.AspNetCore.Mvc.Rendering
@model EnrollmentsIndexVM
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Enrollments";
}

<!-- Title row -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Enrollments</h1>
    <a asp-action="Create" class="btn btn-primary">New Enrollment</a>
</div>

<!-- Toolbar row -->
<form method="get" class="toolbar-row mb-3">
    <div class="toolbar-left">
        <!-- Search input with icon -->
        <div class="input-group" style="width: 280px;">
            <span class="input-group-text toolbar-input"><i class="bi bi-search"></i></span>
            <input type="search" name="q" class="form-control toolbar-input" placeholder="Search..." value="@Model.Search" />
        </div>

        <!-- Status filter -->
        <select name="status" class="form-select form-select-sm toolbar-select" style="width: auto; min-width:150px;" onchange="this.form.submit();">
            <option value="">All statuses</option>
            @foreach (var s in Enum.GetValues(typeof(EnrollmentStatus)).Cast<EnrollmentStatus>())
            {
                <option value="@((int)s)" selected="@(Model.Status == s)">@s</option>
            }
        </select>

        <!-- Grade level filter -->
        <select name="gradeId" class="form-select form-select-sm toolbar-select" style="width: auto; min-width:150px;" onchange="this.form.submit();">
            <option value="">All grades</option>
            @foreach (var g in Model.GradeLevels)
            {
                <option value="@g.Value" selected="@(Model.GradeLevelId?.ToString() == g.Value)">@g.Text</option>
            }
        </select>

        <!-- School year filter -->
        <select name="schoolYearId" class="form-select form-select-sm toolbar-select" style="width: auto; min-width:150px;" onchange="this.form.submit();">
            <option value="">All school years</option>
            @foreach (var y in Model.SchoolYears)
            {
                <option value="@y.Value" selected="@(Model.SchoolYearId?.ToString() == y.Value)">@y.Text</option>
            }
        </select>
    </div>
</form>

<table class="ec-table">
    <thead>
        <tr>
            <th>Student ID</th>
            <th>Student</th>
            <th>Applying for</th>
            <th>School year</th>
            <th>Applied</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var e in Model.Items)
    {
        <tr>
            <td class="cell-id">@e.Student.StudentNumber</td>
            <td class="fw-semibold">@e.Student.FullName</td>
            <td>@e.GradeLevel.Name</td>
            <td>@e.SchoolYear.Name</td>
            <td>@e.ApplicationDate.ToString("yyyy-MM-dd")</td>
            <td><span class="badge @e.StatusClass">@e.Status</span></td>
            <td class="text-end text-nowrap">
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-three-dots-vertical"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <a class="dropdown-item" asp-action="Details" asp-route-id="@e.Id">
                                <i class="bi bi-eye me-2"></i> View Details
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" asp-action="Edit" asp-route-id="@e.Id">
                                <i class="bi bi-pencil me-2"></i> Edit
                            </a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-action="Delete" asp-route-id="@e.Id" method="post" class="d-inline" data-confirm="Delete this application?">
                                    <button type="submit" class="dropdown-item text-danger" style="background:none; border:none; padding:0.25rem 1rem; text-align:left; width:100%;">
                                        <i class="bi bi-trash me-2"></i> Delete
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </td>
        </tr>
    }
    </tbody>
</table>

@if (!Model.Items.Any())
{
    <p class="text-body-secondary text-center py-3">No applications yet.</p>
}
else
{
    <!-- Pagination footer -->
    <partial name="_PaginationFooter" model='new PaginationFooterVM
    {
        Action = "Index",
        Page = Model.Page,
        PageSize = Model.PageSize,
        TotalCount = Model.TotalCount,
        AriaLabel = "Enrollments pagination",
        RouteValues = new Dictionary<string, object?>
        {
            ["q"] = Model.Search,
            ["status"] = Model.Status,
            ["gradeId"] = Model.GradeLevelId,
            ["schoolYearId"] = Model.SchoolYearId
        }
    }' />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
