@model IEnumerable<EduCore.Models.Entities.Enrollment>
@using EduCore.Models.Entities
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Enrollments";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Enrollments</h1>
    <a asp-action="Create" class="btn btn-primary">New application</a>
</div>

<table class="ec-table">
    <thead>
        <tr>
            <th>Student</th>
            <th>Applying for</th>
            <th>School year</th>
            <th>Applied</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var e in Model)
    {
        <tr>
            <td>@e.Student.FullName</td>
            <td>@e.GradeLevel.Name</td>
            <td>@e.SchoolYear.Name</td>
            <td>@e.ApplicationDate.ToString("yyyy-MM-dd")</td>
            <td><span class="badge @e.StatusClass">@e.Status</span></td>
            <td class="text-end">
                @if (e.Status == EnrollmentStatus.Applied)
                {
                    <form class="d-inline" asp-action="SetStatus" asp-route-id="@e.Id" asp-route-status="@EnrollmentStatus.Approved" method="post">
                        <button class="btn btn-sm btn-success">Approve</button>
                    </form>
                    <form class="d-inline" asp-action="SetStatus" asp-route-id="@e.Id" asp-route-status="@EnrollmentStatus.Rejected" method="post">
                        <button class="btn btn-sm btn-outline-danger">Reject</button>
                    </form>
                }
                else if (e.Status == EnrollmentStatus.Approved)
                {
                    <form class="d-inline" asp-action="SetStatus" asp-route-id="@e.Id" asp-route-status="@EnrollmentStatus.Withdrawn" method="post">
                        <button class="btn btn-sm btn-outline-warning">Withdraw</button>
                    </form>
                }
                <form class="d-inline" asp-action="Delete" asp-route-id="@e.Id" method="post"
                      onsubmit="return confirm('Delete this application?');">
                    <button class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
@if (!Model.Any()) { <p class="text-body-secondary">No applications yet.</p> }