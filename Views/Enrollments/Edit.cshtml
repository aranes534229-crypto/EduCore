@model EduCore.Models.Entities.Enrollment
@using EduCore.Models.Entities
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Edit application";
}
<h1 class="h3 mb-4">Edit application</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="ec-card p-4">
        <div class="col-md-6 col-12 mb-3">
            <label asp-for="StudentId" class="form-label">Student</label>
            <select asp-for="StudentId" asp-items="@ViewBag.Students" class="form-select">
                <option value="">— select student —</option>
            </select>
            <span asp-validation-for="StudentId" class="text-danger"></span>
        </div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="GradeLevelId" class="form-label">Applying for</label>
                <select asp-for="GradeLevelId" asp-items="@ViewBag.GradeLevels" class="form-select"></select>
                <span asp-validation-for="GradeLevelId" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="SchoolYearId" class="form-label">School year</label>
                <select asp-for="SchoolYearId" asp-items="@ViewBag.SchoolYears" class="form-select"></select>
                <span asp-validation-for="SchoolYearId" class="text-danger"></span>
            </div>
        </div>
        <div class="mt-3">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
        </div>
    </div>
    <button type="submit" class="btn btn-primary mt-4">Save</button>
    <a asp-action="Index" class="btn btn-link mt-4">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}