@model EduCore.Models.Entities.Faculty
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Add Teacher";
}
<h1 class="h3 mb-4">Add Teacher</h1>
<form asp-action="Create" method="post">
    <div class="ec-card p-4">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="Person.FirstName" class="form-label">First Name</label>
                <input asp-for="Person.FirstName" class="form-control" />
                <span asp-validation-for="Person.FirstName" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Person.LastName" class="form-label">Last Name</label>
                <input asp-for="Person.LastName" class="form-control" />
                <span asp-validation-for="Person.LastName" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Person.Email" class="form-label">Email</label>
                <input asp-for="Person.Email" class="form-control" type="email" />
                <div class="form-text">A Faculty login (password reset via the account) is created automatically.</div>
                <span asp-validation-for="Person.Email" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Person.Phone" class="form-label">Phone</label>
                <input asp-for="Person.Phone" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="Person.Address" class="form-label">Address</label>
                <input asp-for="Person.Address" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="EmployeeNumber" class="form-label">Employee Number</label>
                <input asp-for="EmployeeNumber" class="form-control" />
                <span asp-validation-for="EmployeeNumber" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="HireDate" class="form-label">Hire Date</label>
                <input asp-for="HireDate" class="form-control" type="date" />
            </div>
        </div>
    </div>
    <button type="submit" class="btn btn-primary mt-4">Save</button>
    <a asp-action="Index" class="btn btn-link mt-4">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}