@model EduCore.Models.Entities.Faculty
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Teacher";
    ViewData["Active"] = "Faculty";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@Model.FullName</h1>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
        <a asp-action="Index" class="btn btn-sm btn-link">Back to Faculty</a>
    </div>
</div>

<div class="ec-card p-4">
    <dl class="row mb-0">
        <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
        <dt class="col-sm-3">Contact</dt><dd class="col-sm-9">@Model.Contact</dd>
        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">
            @if (Model.IsActive) { <span class="badge text-bg-success">Active</span> }
            else { <span class="badge text-bg-secondary">Inactive</span> }
        </dd>
        <dt class="col-sm-3">Login</dt>
        <dd class="col-sm-9">
            @if (Model.ApplicationUserId is null)
            {
                <span class="text-body-secondary">No login account</span>
            }
            else
            {
                <span class="badge text-bg-light border">@Model.Email</span>
            }
        </dd>
    </dl>
</div>

<div class="mt-4 pt-3 border-top">
    <form asp-action="Delete" method="post" onsubmit="return confirm('Remove @Model.FullName?');">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-sm btn-outline-danger">Remove Teacher</button>
    </form>
</div>