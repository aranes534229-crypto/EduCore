@using EduCore.Models.Entities
@using Microsoft.AspNetCore.Mvc.Rendering
@model IEnumerable<Inquiry>
@{
    ViewData["Title"] = "Inquiries";
    var names = (Dictionary<string, string>)ViewBag.Names;
    var assignees = (IEnumerable<SelectListItem>)ViewBag.Assignees;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Inquiries</h2>
    <a asp-action="Create" class="btn btn-primary">New inquiry</a>
</div>

<table class="table table-sm align-middle">
    <thead>
        <tr><th>Student</th><th>Applying for</th><th>Contact</th><th>Date</th><th>Status</th><th>Assigned to</th><th class="text-end">Actions</th></tr>
    </thead>
    <tbody>
    @foreach (var i in Model)
    {
        <tr>
            <td class="fw-semibold">@i.StudentName</td>
            <td>@i.GradeLevel.Name</td>
            <td>@i.ContactEmail<br /><span class="text-body-secondary small">@(i.Notes ?? "")</span></td>
            <td>@i.DateCreated.ToString("MMM d")</td>
            <td><span class="badge @i.StatusClass">@i.Status</span></td>
            <td>
                @if (i.AssignedToId != null && names.TryGetValue(i.AssignedToId, out var n)) { <div class="small">@n</div> }
                <form asp-action="Assign" asp-route-id="@i.Id" method="post" class="d-flex gap-1 mt-1">
                    <select name="assignedToId" class="form-select form-select-sm" style="min-width: 8rem;">
                        <option value="">—</option>
                        @foreach (var opt in assignees)
                        {
                            var sel = i.AssignedToId == opt.Value;
                            <option value="@opt.Value" selected="@sel">@opt.Text</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-sm btn-outline-primary">Set</button>
                </form>
            </td>
            <td class="text-end">
                @if (i.Status == InquiryStatus.New)
                {
                    <form asp-action="SetStatus" asp-route-id="@i.Id" method="post" class="d-inline">
                        <button type="submit" name="status" value="InProgress" class="btn btn-sm btn-primary">Start</button>
                    </form>
                }
                @if (i.Status == InquiryStatus.InProgress)
                {
                    <form asp-action="SetStatus" asp-route-id="@i.Id" method="post" class="d-inline">
                        <button type="submit" name="status" value="Converted" class="btn btn-sm btn-success">Convert</button>
                    </form>
                }
                @if (i.Status == InquiryStatus.New || i.Status == InquiryStatus.InProgress)
                {
                    <form asp-action="SetStatus" asp-route-id="@i.Id" method="post" class="d-inline">
                        <button type="submit" name="status" value="Closed" class="btn btn-sm btn-outline-secondary">Close</button>
                    </form>
                    <form asp-action="Delete" asp-route-id="@i.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this inquiry?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
@if (!Model.Any()) { <p class="text-body-secondary">No inquiries yet.</p> }