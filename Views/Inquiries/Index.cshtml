@using EduCore.Models.Entities
@using Microsoft.AspNetCore.Mvc.Rendering
@model IEnumerable<Inquiry>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Inquiries";
    var names = (Dictionary<string, string>)ViewBag.Names;
}
<div class="mb-3">
    <h1 class="h3 mb-0">Inquiries</h1>
</div>

<table class="ec-table">
    <thead>
        <tr>
            <th>#</th>
            <th>Student</th>
            <th>Applying for</th>
            <th>Contact</th>
            <th>Date</th>
            <th>Status</th>
            <th>Assigned to</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var i in Model)
    {
        <tr>
            <td>@i.InquiryNumber</td>
            <td class="fw-semibold">@i.StudentName</td>
            <td>@i.GradeLevel.Name</td>
            <td>
                @i.ContactEmail<br />
                <span class="small text-break">@(i.InternalNotes ?? "")</span>
                @* parent origin is tracked via CreatedByUserId; no visual badge *@
            </td>
            <td>@i.DateCreated.ToString("MMM d")</td>
            <td><span class="badge @i.StatusClass">@i.Status</span></td>
            <td>
                @if (i.AssignedToId != null && names.TryGetValue(i.AssignedToId, out var assignedName))
                {
                    <div class="small">@assignedName</div>
                }
            </td>
            <td class="text-end text-nowrap">
                <a asp-action="Details" asp-route-id="@i.Id" class="btn btn-sm btn-outline-secondary">View</a>
                @if (i.ConvertedStudentId == null && i.Status != InquiryStatus.Rejected)
                {
                    <form asp-action="Convert" asp-route-id="@i.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-success">Approve</button>
                    </form>
                    <details class="d-inline">
                        <summary class="btn btn-sm btn-outline-danger">Reject</summary>
                        <div class="ec-card p-2 mt-1 text-start" style="min-width: 18rem;">
                            <form asp-action="Reject" asp-route-id="@i.Id" method="post">
                                <textarea name="reason" class="form-control form-control-sm" required
                                          placeholder="Reason for rejection"></textarea>
                                <button type="submit" class="btn btn-sm btn-danger mt-1">Confirm reject</button>
                            </form>
                        </div>
                    </details>
                }
                @if (User.IsInRole("Admin"))
                {
                    <form asp-action="Delete" asp-route-id="@i.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this inquiry?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
@if (!Model.Any()) { <p class="text-body-secondary">No inquiries yet.</p> }