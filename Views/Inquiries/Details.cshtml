@using EduCore.Models.Entities
@model Inquiry
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Inquiry Details";
    var names = (Dictionary<string, string>)ViewBag.Names;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Inquiry #@Model.InquiryNumber</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
</div>

<div class="ec-card p-4 mb-4">
    <div class="row mb-3">
        <div class="col-md-6">
            <h6 class="text-uppercase fw-semibold">Student Information</h6>
            <p class="mb-1"><strong>Name:</strong> @Model.StudentName</p>
            <p><strong>Grade Level:</strong> @Model.GradeLevel.Name</p>
        </div>
        <div class="col-md-6">
            <h6 class="text-uppercase fw-semibold">Contact Information</h6>
            <p class="mb-1"><strong>Email:</strong> @Model.ContactEmail</p>
            <p><strong>Phone:</strong> @Model.ContactPhone</p>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-12">
            <h6 class="text-uppercase fw-semibold">Inquiry Details</h6>
            <p class="mb-1"><strong>Date Submitted:</strong> @Model.DateCreated.ToString("yyyy-MM-dd")</p>
            <p class="mb-1"><strong>Status:</strong> <span class="badge @Model.StatusClass">@Model.Status</span></p>
            <p><strong>Assigned To:</strong> @(Model.AssignedToId != null && names.TryGetValue(Model.AssignedToId, out var assignedName) ? assignedName : "Unassigned")</p>
        </div>
    </div>
</div>

@if (Model.Status == InquiryStatus.Rejected)
{
    var reason = Model.Thread
        .OrderByDescending(n => n.Timestamp)
        .FirstOrDefault(n => n.Body.StartsWith("Inquiry rejected:"))?
        .Body.Replace("Inquiry rejected: ", "");
    <div class="alert alert-danger mb-4">
        <strong>Rejected</strong> — @(string.IsNullOrEmpty(reason) ? "No reason provided." : reason)
    </div>
}

@if (Model.ConvertedStudentId != null)
{
    <div class="alert alert-success mb-4">
        <strong>Approved</strong> — Student @(Model.ConvertedStudent?.StudentNumber ?? $"#{Model.ConvertedStudentId}") created.
        @if (Model.ConvertedEnrollmentId != null)
        {
            <span>Enrollment application awaiting approval.</span>
        }
    </div>
}
else if (Model.Status != InquiryStatus.New)
{
    <div class="alert alert-info mb-4">
        <strong>@Model.Status</strong> — No further actions available.
    </div>
}
else
{
    <div class="ec-card p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">Enrollment Application</h5>
        </div>
        <div class="row mb-3">
            <div class="col-md-4">
                <h6 class="text-uppercase fw-semibold">Birth date</h6>
                <div>@(Model.BirthDate?.ToString("yyyy-MM-dd") ?? "-")</div>
            </div>
            <div class="col-md-4">
                <h6 class="text-uppercase fw-semibold">Address</h6>
                <div>@(string.IsNullOrEmpty(Model.Address) ? "-" : Model.Address)</div>
            </div>
            <div class="col-md-4">
                <h6 class="text-uppercase fw-semibold">Guardian</h6>
                <div>@(string.IsNullOrEmpty(Model.GuardianName) ? "-" : Model.GuardianName)</div>
            </div>
        </div>
        <h6 class="text-uppercase fw-semibold mb-2">Documents</h6>
        @if (Model.Documents.Any())
        {
            <ul class="mb-3">
                @foreach (var d in Model.Documents)
                {
                    <li>
                        <a href="@Url.Content($"~/{d.Path}")" target="_blank" rel="noopener">@d.FileName</a>
                        <span class="small">(@d.Type, @d.UploadedAt.ToString("yyyy-MM-dd"))</span>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="small mb-3">No documents uploaded yet.</p>
        }

        <div style="display:flex; gap:0.75rem; align-items:center; justify-content:flex-start; margin-top:1.5rem; padding-top:1rem; border-top:1px solid var(--bs-border-color);">
            <!-- Approve button -->
            <form asp-action="Convert" asp-route-id="@Model.Id" method="post" id="approveForm">
                <button type="submit" class="btn btn-primary" id="btnApprove" style="padding:0.5rem 1.25rem; width:fit-content;">
                    <span class="btn-text">Approve enrollment</span>
                    <span class="btn-loading d-none"><span class="spinner-border spinner-border-sm me-1"></span>Processing...</span>
                </button>
            </form>

            <!-- Reject button triggers modal -->
            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#rejectModal" id="btnReject" style="padding:0.5rem 1.25rem; width:fit-content;">
                <span class="btn-text">Reject enrollment</span>
                <span class="btn-loading d-none"><span class="spinner-border spinner-border-sm me-1"></span>Processing...</span>
            </button>
        </div>
    </div>

    <!-- Reject Modal -->
    <div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="Reject" asp-route-id="@Model.Id" method="post" id="rejectForm">
                    <div class="modal-header">
                        <h5 class="modal-title" id="rejectModalLabel">Reject Enrollment</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="reason" class="form-label">Reason for rejection</label>
                            <textarea name="reason" id="reason" class="form-control" rows="3" required placeholder="Enter reason..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger" id="btnRejectSubmit">Confirm reject</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Approve form loading state
            const approveForm = document.getElementById('approveForm');
            if (approveForm) {
                approveForm.addEventListener('submit', function () {
                    const btn = document.getElementById('btnApprove');
                    if (btn) {
                        btn.disabled = true;
                        btn.querySelector('.btn-text').classList.add('d-none');
                        btn.querySelector('.btn-loading').classList.remove('d-none');
                    }
                });
            }

            // Reject form loading state
            const rejectForm = document.getElementById('rejectForm');
            if (rejectForm) {
                rejectForm.addEventListener('submit', function () {
                    const btn = document.getElementById('btnRejectSubmit');
                    const triggerBtn = document.getElementById('btnReject');
                    if (btn) {
                        btn.disabled = true;
                        btn.querySelector('.btn-text')?.classList.add('d-none');
                        btn.querySelector('.btn-loading')?.classList.remove('d-none');
                    }
                    if (triggerBtn) {
                        triggerBtn.disabled = true;
                        triggerBtn.querySelector('.btn-text').classList.add('d-none');
                        triggerBtn.querySelector('.btn-loading').classList.remove('d-none');
                    }
                });
            }
        });
    </script>
}

