@model IEnumerable<EduCore.Models.Entities.Fee>
@{
    ViewData["Title"] = "Fees";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Fees</h2>
    <a asp-action="Create" class="btn btn-primary">Add fee</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-body-secondary mb-0">No fees yet. Add one to get started.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">Fee</th>
                    <th scope="col" class="text-end">Amount</th>
                    <th scope="col">Grade</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody class="table-group-divider">
                @foreach (var f in Model)
                {
                    <tr>
                        <td class="fw-medium">@f.Name</td>
                        <td class="text-end">@f.Amount.ToString("N2")</td>
                        <td>@(f.GradeLevel?.Name ?? "<span class='text-muted'>Shared</span>")</td>
                        <td>
                            @if (f.IsActive)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary bg-opacity-10 text-secondary">Inactive</span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="d-flex justify-content-center gap-1">
                                <a asp-action="Details" asp-route-id="@f.Id" class="btn btn-sm btn-outline-secondary" title="View">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@f.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@f.Id" method="post"
                                      onsubmit="return confirm('Delete this fee?');"
                                      data-bs-toggle="tooltip" title="Delete">
                                    <button class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
