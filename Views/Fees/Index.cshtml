@model IEnumerable<EduCore.Models.Entities.Fee>
@{
    ViewData["Title"] = "Fees";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Fees</h2>
    <a asp-action="Create" class="btn btn-primary">Add fee</a>
</div>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>Fee</th>
            <th class="text-end">Amount</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var f in Model)
    {
        <tr>
            <td>@f.Name</td>
            <td class="text-end">@f.Amount.ToString("N2")</td>
            <td>@(f.IsActive ? "Active" : "Inactive")</td>
            <td class="text-end">
                <form asp-action="Delete" asp-route-id="@f.Id" method="post"
                      onsubmit="return confirm('Delete this fee?');">
                    <button class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
@if (!Model.Any()) { <p class="text-body-secondary">No fees yet. Add one.</p> }