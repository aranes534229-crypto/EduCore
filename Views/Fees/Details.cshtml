@model EduCore.Models.Entities.Fee
@{
    ViewData["Title"] = "Fee details";
}

<h2>Fee details</h2>

<div class="card mt-3">
    <div class="card-body">
        <h5 class="card-title">@Model.Name</h5>
        <dl class="row mb-0">
            <dt class="col-sm-3">Grade</dt>
            <dd class="col-sm-9">@(Model.GradeLevel?.Name ?? "Shared (all grades)")</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @if (Model.IsActive)
                {
                    <span class="badge bg-success bg-opacity-10 text-success">Active</span>
                }
                else
                {
                    <span class="badge bg-secondary bg-opacity-10 text-secondary">Inactive</span>
                }
            </dd>
        </dl>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header">
        <h6 class="mb-0">Student Assessment Breakdown</h6>
    </div>
    <div class="card-body p-0">
        <table class="table table-sm table-borderless align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">Charge Description</th>
                    <th scope="col" class="text-end">Amount</th>
                </tr>
            </thead>
            <tbody class="table-group-divider">
                @if (!Model.Lines.Any(l => l.IsActive))
                {
                    <tr>
                        <td colspan="2" class="text-center text-muted py-3">No active line items.</td>
                    </tr>
                }
                else
                {
                    @foreach (var l in Model.Lines.Where(l => l.IsActive))
                    {
                        <tr>
                            <td>@l.Description</td>
                            <td class="text-end">@l.Amount.ToString("N2")</td>
                        </tr>
                    }
                    <tr class="table-active">
                        <th scope="row">Total</th>
                        <td class="text-end fw-medium">@Model.TotalAmount.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-4 d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
</div>
