@model EduCore.Models.Entities.Fee
@{
    ViewData["Title"] = "Edit fee";
}

<h2>Edit fee</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="row g-3 col-md-6 col-12">
        <div class="col-md-7">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>
        <div class="col-md-5">
            <label asp-for="Amount" class="form-label"></label>
            <input asp-for="Amount" class="form-control" />
            <span asp-validation-for="Amount" class="text-danger small"></span>
        </div>
    </div>

    <div class="mt-3">
        <label asp-for="GradeLevelId" class="form-label">Grade</label>
        <select asp-for="GradeLevelId" asp-items="ViewBag.GradeLevels" class="form-select">
            <option value="">— Shared fee (no specific grade) —</option>
        </select>
        <span asp-validation-for="GradeLevelId" class="text-danger small"></span>
    </div>

    <div class="mt-3 form-check">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label"></label>
    </div>

    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}