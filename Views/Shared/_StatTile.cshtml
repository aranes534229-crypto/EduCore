@model EduCore.ViewModels.StatTileVM
@* A reusable stat tile: label above, value below, optional CSS class on the value.
   ColClass / ValueClass are optional — null degrades to the defaults below. *@
<div class="@(Model.ColClass ?? "col-md-4")">
    <div class="card">
        <div class="card-body">
            <div class="text-body-secondary">@Model.Label</div>
            <div class="fs-4 @(Model.ValueClass ?? "")">@Model.Value</div>
        </div>
    </div>
</div>