@* Standard TempData alert display — Error / Info / Saved *@
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger py-2">@error</div>
}
@if (TempData["Info"] is string info)
{
    <div class="alert alert-info py-2">@info</div>
}
@if (TempData["Saved"] is string saved)
{
    <div class="alert alert-success py-2">@saved</div>
}
