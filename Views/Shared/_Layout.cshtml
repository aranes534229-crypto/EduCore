<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EduCore</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EduCore.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/jpeg" href="~/images/logo-educore.jpg" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/images/logo-educore.jpg" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">EduCore</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        @if (User.IsInRole("Admin") || User.IsInRole("Registrar"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Students" asp-action="Index">Students</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Enrollments" asp-action="Index">Enrollments</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Inquiries" asp-action="Index">Inquiries</a>
                            </li>
                        }
                        @if (User.IsInRole("Registrar"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Sections" asp-action="Index">Class Schedule</a>
                            </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Sections" asp-action="Index">Sections</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Faculty" asp-action="Index">Faculty</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Subjects" asp-action="Index">Subjects</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Fees" asp-action="Index">Fees</a>
                            </li>
                        }
                        @if (User.IsInRole("Admin") || User.IsInRole("Finance"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Invoices" asp-action="Index">Tuition & Billing</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Expenses" asp-action="Index">Accounting & Expenses</a>
                            </li>
                        }
                        @if (User.IsInRole("Admin") || User.IsInRole("Faculty") || User.IsInRole("Parent"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Messages" asp-action="Index">Messages</a>
                            </li>
                        }
                        @if (User.IsInRole("Admin") || User.IsInRole("Registrar") || User.IsInRole("Faculty") || User.IsInRole("Parent"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Announcements" asp-action="Index">Announcements</a>
                            </li>
                        }
                        @if (User.IsInRole("Parent"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Inquiries" asp-action="MyInquiries">My Inquiries</a>
                            </li>
                        }
                        @if (User.IsInRole("Admin") || User.IsInRole("Faculty"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Gradebook" asp-action="Index">Gradebook</a>
                            </li>
                        }
                    @if (User.IsInRole("Finance"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Students" asp-action="Index">Students</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Messages" asp-action="Index">Messages</a>
                            </li>
                        }
                    @if (User.IsInRole("Admin") || User.IsInRole("Registrar") || User.IsInRole("Finance") || User.IsInRole("Faculty"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Reports" asp-action="Index">Reports</a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - EduCore - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
