@using EduCore.Models.Constants
@model AccountsIndexVM
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Accounts";
}

<!-- Title row -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Accounts</h1>
    <a asp-action="Create" class="btn btn-primary">Add Account</a>
</div>

<partial name="_TempAlert" />

<!-- Toolbar row -->
<form method="get" class="toolbar-row mb-3">
    <div class="toolbar-left">
        <!-- Search input with icon -->
        <div class="input-group" style="width: 280px;">
            <span class="input-group-text toolbar-input"><i class="bi bi-search"></i></span>
            <input type="search" name="q" class="form-control toolbar-input" placeholder="Search..." value="@Model.Search" />
        </div>

        <!-- Role filter -->
        <select name="role" class="form-select form-select-sm toolbar-select" style="width: auto; min-width:150px;" onchange="this.form.submit();">
            <option value="">All roles</option>
            @foreach (var r in Model.RoleValues)
            {
                <option value="@r.Value" selected="@(Model.Role == r.Value)">@r.Text</option>
            }
        </select>

        <!-- Locked filter -->
        <select name="locked" class="form-select form-select-sm toolbar-select" style="width: auto; min-width:150px;" onchange="this.form.submit();">
            <option value="">All statuses</option>
            <option value="true" selected="@(Model.Locked == true)">Locked</option>
            <option value="false" selected="@(Model.Locked == false)">Active</option>
        </select>
    </div>
</form>

<table class="ec-table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var u in Model.Items)
{
        <tr>
            <td class="fw-semibold">@u.DisplayName</td>
            <td>@u.Email</td>
            <td>
                @if (u.Roles.Any())
                {
                    var ordered = u.Roles.OrderBy(r => Array.IndexOf(AppRoles.All, r)).ThenBy(r => r).ToArray();
                    <span class="badge text-bg-primary">@string.Join(", ", ordered)</span>
                }
            </td>
            <td>
                @if (u.IsLocked)
                {
                    <span class="badge text-bg-danger">Locked</span>
                }
                else
                {
                    <span class="badge text-bg-success">Active</span>
                }
            </td>
            <td class="text-end text-nowrap">
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-three-dots-vertical"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <a class="dropdown-item" asp-action="ResetPassword" asp-route-id="@u.Id">
                                <i class="bi bi-key me-2"></i> Reset Password
                            </a>
                        </li>
                        @if (u.Id == Model.CurrentUserId)
                        {
                            <li><hr class="dropdown-divider" /></li>
                            <li><span class="dropdown-item text-body-secondary" title="Can't lock your own account">Can't lock your own account</span></li>
                        }
                        else
                        {
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-action="ToggleLock" asp-route-id="@u.Id" method="post" class="d-inline" data-confirm="@(u.IsLocked ? "Unlock" : "Lock") @u.Email?">
                                    <button type="submit" class="dropdown-item text-danger" style="background:none; border:none; padding:0.25rem 1rem; text-align:left; width:100%;">
                                        <i class="bi bi-@(u.IsLocked ? "unlock" : "lock") me-2"></i> @(u.IsLocked ? "Unlock" : "Lock")
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </td>
        </tr>
}
    </tbody>
</table>

@if (!Model.Items.Any())
{
    <p class="text-body-secondary text-center py-3">No accounts yet.</p>
}
else
{
    <!-- Pagination footer -->
    <partial name="_PaginationFooter" model='new PaginationFooterVM
    {
        Action = "Index",
        Page = Model.Page,
        PageSize = Model.PageSize,
        TotalCount = Model.TotalCount,
        AriaLabel = "Accounts pagination",
        RouteValues = new Dictionary<string, object?>
        {
            ["q"] = Model.Search,
            ["role"] = Model.Role,
            ["locked"] = Model.Locked
        }
    }' />
}
