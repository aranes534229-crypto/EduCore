@model EduCore.Models.Entities.Invoice
@{
    ViewData["Title"] = $"Invoice — {Model.Student.FullName}";
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger py-2">@error</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Invoice — @Model.Student.FullName</h2>
    <div class="text-end fs-5">
        <span class="text-body-secondary">Balance:</span>
        <span class="@(Model.Balance > 0 ? "text-danger fw-bold" : "text-success fw-bold")">@Model.Balance.ToString("N2")</span>
    </div>
</div>
<p class="text-body-secondary">School year: @Model.SchoolYear.Name · Issued @Model.IssuedDate.ToString("yyyy-MM-dd")</p>

<h5>Charges</h5>
<table class="table table-sm col-md-6 col-12">
    <tbody>
    @foreach (var l in Model.Lines)
    {
        <tr>
            <td>@l.Description</td>
            <td class="text-end">@l.Amount.ToString("N2")</td>
        </tr>
    }
        <tr class="fw-semibold">
            <td>Total</td>
            <td class="text-end">@Model.Total.ToString("N2")</td>
        </tr>
    </tbody>
</table>

<h5 class="mt-4">Payments</h5>
<table class="table table-sm col-md-6 col-12">
    <thead>
        <tr>
            <th>Date</th>
            <th>Method</th>
            <th>Reference</th>
            <th class="text-end">Amount</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var p in Model.Payments)
    {
        <tr>
            <td>@p.Date.ToString("yyyy-MM-dd")</td>
            <td>@p.Method</td>
            <td>@(p.Reference ?? "—")</td>
            <td class="text-end">@p.Amount.ToString("N2")</td>
        </tr>
    }
    </tbody>
</table>
@if (Model.Payments.Count == 0) { <p class="text-body-secondary">No payments yet.</p> }

<h5 class="mt-4">Record payment</h5>
<form asp-action="AddPayment" asp-route-id="@Model.Id" method="post" class="row g-3 col-md-6 col-12">
    <div class="col-md-3">
        <label for="pf_Amount" class="form-label">Amount</label>
        <input name="p.Amount" id="pf_Amount" class="form-control" type="number" step="0.01" min="0.01" required />
    </div>
    <div class="col-md-3">
        <label for="pf_Date" class="form-label">Date</label>
        <input name="p.Date" id="pf_Date" class="form-control" type="date" />
    </div>
    <div class="col-md-3">
        <label for="pf_Method" class="form-label">Method</label>
        <input name="p.Method" id="pf_Method" class="form-control" placeholder="Cash / GCash / Bank" />
    </div>
    <div class="col-md-3">
        <label for="pf_Reference" class="form-label">Reference</label>
        <input name="p.Reference" id="pf_Reference" class="form-control" />
    </div>
    <div>
        <button type="submit" class="btn btn-primary mt-3">Record payment</button>
    </div>
</form>

<div class="mt-4">
    <a asp-action="Index" class="btn btn-link">Back to invoices</a>
</div>