@using EduCore.Models.Entities
@model IEnumerable<Message>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Messages";
    var names = (Dictionary<string, string>)ViewBag.Names;
    var students = (Dictionary<int, Student>)ViewBag.Students;
    var unread = (HashSet<int>)ViewBag.UnreadIds;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Messages</h1>
    @if (ViewBag.CanCompose)
    {
        <a asp-action="Create" class="btn btn-primary">New message</a>
    }
</div>

@if (!Model.Any())
{
    <p class="text-body-secondary">No messages yet.</p>
}
else
{
    foreach (var m in Model)
    {
        var about = students.TryGetValue(m.StudentId, out var s) ? s.FullName : "—";
        var isFromMe = m.SenderId == (string)ViewBag.UserId;
        var other = isFromMe
            ? names.GetValueOrDefault(m.RecipientId, "?")
            : names.GetValueOrDefault(m.SenderId, "?");
        var isNew = unread.Contains(m.Id);
        <div class="ec-card p-4 mb-3">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <a asp-action="Thread" asp-route-studentId="@m.StudentId" class="text-decoration-none fw-semibold">
                    @(isFromMe ? "You" : other) → @(isFromMe ? other : "You")
                    <span class="text-body-secondary fw-normal">about @about</span>
                </a>
                <span class="small text-body-secondary text-nowrap ms-3">
                    @m.SentAt.ToLocalTime().ToString("MMM d, HH:mm")
                    @if (isNew) { <span class="badge text-bg-primary">New</span> }
                </span>
            </div>
            <p class="mb-1">@m.Body</p>
            <a asp-action="Thread" asp-route-studentId="@m.StudentId" class="small">Reply</a>
        </div>
    }
}