@using EduCore.Models.Entities
@model IEnumerable<Message>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Messages";
    var meId = (string)ViewBag.UserId;
    var otherParty = (string?)ViewBag.OtherParty ?? "?";
    var student = (Student)ViewBag.Student;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@student.FullName</h1>
    <div class="d-flex gap-2 align-items-center">
        <span class="text-body-secondary small">Conversation with @otherParty</span>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to messages</a>
    </div>
</div>

<div class="ec-card p-4">
    <h6 class="text-uppercase text-body-secondary mb-3">Conversation</h6>
    @if (!Model.Any())
    {
        <p class="text-body-secondary small mb-0">No messages yet. Send one below.</p>
    }
    else
    {
        <div class="border rounded p-3 bg-light" style="max-height: 400px; overflow-y: auto;">
            @foreach (var m in Model)
            {
                var isFromMe = m.SenderId == meId;
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-baseline">
                        <small class="fw-semibold text-body-secondary">
                            @(isFromMe ? "You" : otherParty) — @m.SentAt.ToLocalTime().ToString("MMM d, yyyy HH:mm")
                        </small>
                        @if (isFromMe)
                        {
                            <span class="small text-body-secondary">sent</span>
                        }
                    </div>
                    <div class="mt-1 @(isFromMe ? "text-end" : "")">@m.Body</div>
                </div>
            }
        </div>
    }

    <h6 class="text-uppercase text-body-secondary mt-4 mb-3">Reply</h6>
    <form asp-action="Thread" asp-route-studentId="@student.Id" method="post" class="col-lg-7 col-12">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <textarea name="body" class="form-control" rows="4" required></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Send</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}