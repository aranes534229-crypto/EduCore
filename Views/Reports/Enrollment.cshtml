@model EnrollmentReportVM
@using EduCore.Models.Entities
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Enrollment report";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Enrollment report</h1>
</div>

<!-- ooolbar row -->
<form method="get" class="toolbar-row mb-3">
    <div class="toolbar-left">
        <!-- Search input with icon -->
        <div class="input-group" style="width: 280px;">
            <span class="input-group-text toolbar-input"><i class="bi bi-search"></i></span>
            <input type="search" name="q" class="form-control toolbar-input" placeholder="Search..." value="@Model.Search" />
        </div>

        <!-- School year filter -->
        <select name="schoolYearId" class="form-select form-select-sm toolbar-select" style="width: auto; min-width:150px;" onchange="this.form.submit();">
            <option value="">All school years</option>
            @foreach (var y in Model.SchoolYears)
            {
                <option value="@y.Value" selected="@(Model.SelectedYear?.ToString() == y.Value)">@y.Text</option>
            }
        </select>
    </div>
</form>

<!-- Summary tiles -->
<div class="row g-3 mb-3">
    <partial name="_StatTile" model="@(new StatTileVM { ColClass = "col-md-2 col-6", Label = "Total", Value = Model.Total.ToString() })" />
    @foreach (var status in Enum.GetValues<EnrollmentStatus>())
    {
        <partial name="_StatTile" model="@(new StatTileVM { ColClass = "col-md-2 col-6", Label = status.ToString(), Value = Model.Totals[status].ToString() })" />
    }
</div>

@if (Model.Items.Count == 0)
{
    <p class="text-body-secondary">No enrollments for @Model.YearName.</p>
}
else
{
    <table class="ec-table">
        <thead>
            <tr><th>Student</th><th>Grade</th><th>Applied</th><th>Status</th></tr>
        </thead>
        <tbody>
            @foreach (var e in Model.Items)
            {
                <tr>
                    <td>@e.Student.FullName</td>
                    <td>@e.GradeLevel.Name</td>
                    <td>@e.ApplicationDate.ToString("MMM d, yyyy")</td>
                    <td><span class="badge @e.StatusClass">@e.Status.ToString()</span></td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Pagination footer -->
    <partial name="_PaginationFooter" model='new PaginationFooterVM
    {
        Action = "Enrollment",
        Page = Model.Page,
        PageSize = Model.PageSize,
        TotalCount = Model.TotalCount,
        AriaLabel = "Enrollment report pagination",
        RouteValues = new Dictionary<string, object?>
        {
            ["q"] = Model.Search,
            ["schoolYearId"] = Model.SelectedYear
        }
    }' />
}
