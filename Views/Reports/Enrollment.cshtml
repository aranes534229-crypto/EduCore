@model List<Enrollment>
@using EduCore.Models.Entities
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Enrollment report";
    var totals = (Dictionary<EnrollmentStatus, int>)ViewBag.Totals;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Enrollment report</h1>
</div>

<form method="get" class="row g-2 align-items-center mb-3 col-md-6 col-12">
    <div class="col-auto">
        <label class="form-label mb-0">School year</label>
        <select name="schoolYearId" asp-items="ViewBag.SchoolYears" class="form-select form-select-sm"
                onchange="this.form.submit()"></select>
    </div>
    <div class="col-auto">
        <button class="btn btn-primary btn-sm">Go</button>
    </div>
</form>

<div class="row g-3 mb-3">
    <partial name="_StatTile" model="@(new StatTileVM { ColClass = "col-md-2 col-6", Label = "Total", Value = ViewBag.Total.ToString() })" />
    @foreach (var status in Enum.GetValues<EnrollmentStatus>())
    {
        <partial name="_StatTile" model="@(new StatTileVM { ColClass = "col-md-2 col-6", Label = status.ToString(), Value = totals[status].ToString() })" />
    }
</div>

@if (Model.Count == 0)
{
    <p class="text-body-secondary">No enrollments for @ViewBag.YearName.</p>
}
else
{
    <table class="ec-table">
        <thead>
            <tr><th>Student</th><th>Grade</th><th>Applied</th><th>Status</th></tr>
        </thead>
        <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td>@e.Student.FullName</td>
                    <td>@e.GradeLevel.Name</td>
                    <td>@e.ApplicationDate.ToString("MMM d, yyyy")</td>
                    <td><span class="badge @e.StatusClass">@e.Status.ToString()</span></td>
                </tr>
            }
        </tbody>
    </table>
}