@using EduCore.Controllers
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Reports";
    var cards = (List<ReportsController.ReportCard>)ViewBag.Cards;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Reports</h1>
</div>

@if (cards.Count == 0)
{
    <p class="text-body-secondary">No reports are available for your role.</p>
}
else
{
    <div class="row g-3">
        @foreach (var c in cards)
        {
            <div class="col-md-4">
                <div class="ec-card p-4 d-flex flex-column h-100">
                    <div class="h5 mb-1">@c.Title</div>
                    <p class="text-body-secondary mb-3">@c.Description</p>
                    <a class="btn btn-primary btn-sm mt-auto align-self-start" asp-action="@c.Action">Open report</a>
                </div>
            </div>
        }
    </div>
}