@model List<Invoice>
@using EduCore.Models.Entities
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Money report";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Money report</h1>
</div>

<div class="row g-3 mb-3">
    <partial name="_StatTile" model="@(new StatTileVM { ColClass = "col-md-3 col-6", Label = "Total billed", Value = ((decimal)ViewBag.TotalBilled).ToString("N2") })" />
    <partial name="_StatTile" model="@(new StatTileVM { ColClass = "col-md-3 col-6", Label = "Collected", Value = ((decimal)ViewBag.TotalCollected).ToString("N2"), ValueClass = "text-success" })" />
    <partial name="_StatTile" model="@(new StatTileVM { ColClass = "col-md-3 col-6", Label = "Outstanding", Value = ((decimal)ViewBag.TotalOutstanding).ToString("N2"), ValueClass = "text-danger" })" />
    <partial name="_StatTile" model="@(new StatTileVM { ColClass = "col-md-3 col-6", Label = "Expenses", Value = ((decimal)ViewBag.TotalExpenses).ToString("N2") })" />
</div>

@if (Model.Count == 0)
{
    <p class="text-body-secondary">No invoices yet. Generate one from the Invoices screen to see billing numbers here.</p>
}
else
{
    <table class="ec-table">
        <thead>
            <tr><th>Invoice</th><th>Student</th><th>Total</th><th>Paid</th><th>Balance</th></tr>
        </thead>
        <tbody>
            @foreach (var i in Model)
            {
                <tr>
                    <td>#@i.Id</td>
                    <td>@i.Student.FullName</td>
                    <td>@i.Total.ToString("N2")</td>
                    <td>@i.Paid.ToString("N2")</td>
                    <td class="@((i.Balance > 0) ? "text-danger fw-semibold" : "")">@i.Balance.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>
}