@model IEnumerable<EduCore.Models.Entities.Subject>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Subjects";
    ViewData["Active"] = "Subjects";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Subjects</h1>
    <a asp-action="Create" class="btn btn-primary">New Subject</a>
</div>

@if (TempData["Error"] is not null)
{
    <div class="alert alert-warning py-2">@TempData["Error"]</div>
}

<table class="ec-table">
    <thead><tr><th>Code</th><th>Name</th><th></th></tr></thead>
    <tbody>
    @foreach (var s in Model)
    {
        <tr>
            <td>@s.Code</td>
            <td>@s.Name</td>
            <td class="text-end">
                <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline"
                      onsubmit="return confirm('Delete @s.Name?');">
                    <button class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
@if (!Model.Any()) { <p class="text-body-secondary">No subjects yet.</p> }