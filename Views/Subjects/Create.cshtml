@model EduCore.Models.Entities.Subject
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "New Subject";
}
<h1 class="h3 mb-4">New Subject</h1>
<form asp-action="Create" method="post">
    <div class="ec-card p-4">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control" placeholder="SCI" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>
            <div class="col-md-8">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" placeholder="Science" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>
    </div>
    <button type="submit" class="btn btn-primary mt-4">Save</button>
    <a asp-action="Index" class="btn btn-link mt-4">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}