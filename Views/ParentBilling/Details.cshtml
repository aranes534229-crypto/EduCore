@using EduCore.Models.Constants
@model EduCore.Models.Entities.Invoice
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = $"Tuition & Billing — {Model.Student.FullName}";
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger py-2">@error</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Tuition &amp; Billing — @Model.Student.FullName</h1>
    <div class="text-end fs-5">
        <span class="text-body-secondary">Balance:</span>
        <span class="@(Model.Balance > 0 ? "text-danger fw-bold" : "text-success fw-bold")">@Model.Balance.ToString("N2")</span>
    </div>
</div>
<p class="text-body-secondary">Invoice @(Model.Number ?? "—") · School year: @Model.SchoolYear.Name
    · Issued @Model.IssuedDate.ToString("yyyy-MM-dd")</p>

<h5>Charges</h5>
<table class="ec-table col-lg-6 col-12">
    <tbody>
    @foreach (var l in Model.Lines)
    {
        <tr>
            <td>@l.Description</td>
            <td class="text-end">@l.Amount.ToString("N2")</td>
        </tr>
    }
        <tr class="fw-semibold">
            <td>Total</td>
            <td class="text-end">@Model.Total.ToString("N2")</td>
        </tr>
    </tbody>
</table>

<h5 class="mt-4">Payment history</h5>
@if (Model.Payments.Count == 0)
{
    <p class="text-body-secondary">No payments yet.</p>
}
else
{
    <table class="ec-table col-lg-6 col-12">
        <thead>
            <tr>
                <th>Date</th>
                <th>Method</th>
                <th>Reference</th>
                <th class="text-end">Amount</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var p in Model.Payments)
        {
            <tr>
                <td>@p.Date.ToString("yyyy-MM-dd")</td>
                <td>@p.Method</td>
                <td>@(p.Reference ?? "—")</td>
                <td class="text-end">@p.Amount.ToString("N2")</td>
                <td class="text-end"><a asp-controller="ParentBilling" asp-action="Receipt" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">Receipt</a></td>
            </tr>
        }
        </tbody>
    </table>
}

@if (Model.Balance > 0)
{
    <h5 class="mt-4">Make a payment</h5>
    <form asp-action="Pay" asp-route-id="@Model.Id" method="post" class="row g-3 col-lg-6 col-12">
        @* Parent payments are always debited from the parent's own account — the sole accepted
            Method. Hidden field keeps the value; no dropdown to choose from. *@
        <input type="hidden" name="p.Method" value="@PaymentMethods.ParentOnly" />

        <div class="col-md-4">
            <label for="pf_Amount" class="form-label">Amount</label>
            <input name="p.Amount" id="pf_Amount" class="form-control" type="number" step="0.01"
                   min="0.01" max="@Model.Balance" required />
        </div>
        <div class="col-md-4">
            <label for="pf_Reference" class="form-label">Reference</label>
            <input name="p.Reference" id="pf_Reference" class="form-control" placeholder="Optional" />
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-primary mt-4">Pay @Model.Balance.ToString("N2")</button>
        </div>
        <div class="col-12 small text-body-secondary mt-0">Paid from your parent account.</div>
    </form>
}
else
{
    <p class="text-success mt-4 mb-0"><strong>This statement is fully paid.</strong></p>
}

<div class="mt-4">
    <a asp-action="Index" class="btn btn-link px-0">Back to Tuition &amp; Billing</a>
</div>