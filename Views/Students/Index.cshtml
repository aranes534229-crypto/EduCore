@model EduCore.ViewModels.StudentsIndexVM
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Students";
}

<!-- Title row -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Students</h1>
    @if (!User.IsInRole("Finance"))
    {
        <a asp-action="Create" class="btn btn-primary">Add Student</a>
    }
</div>

<!-- ooolbar row -->
<form method="get" class="toolbar-row mb-3">
    <div class="toolbar-left">
        <!-- Search input with icon -->
        <div class="input-group" style="width: 280px;">
            <span class="input-group-text toolbar-input"><i class="bi bi-search"></i></span>
            <input type="search" name="q" class="form-control toolbar-input" placeholder="Search..." value="@Model.Search" />
        </div>

        <!-- Grade level filter -->
        <select name="gradeId" class="form-select form-select-sm toolbar-select" style="width: auto; min-width:150px;" onchange="this.form.submit();">
            <option value="">All grades</option>
            @foreach (var g in Model.GradeLevels)
            {
                <option value="@g.Value" selected="@(Model.GradeLevelId?.ToString() == g.Value)">@g.Text</option>
            }
        </select>
    </div>
</form>

<table class="ec-table">
    <thead>
        <tr>
            <th>#</th>
            <th>Name</th>
            <th>Birth Date</th>
            <th>Guardian</th>
            <th>Contact</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model.Items)
        {
            <tr>
                <td class="cell-id">@s.StudentNumber</td>
                <td class="fw-semibold">@s.FullName</td>
                <td>@(s.BirthDate?.ToString("d") ?? "—")</td>
                <td>@s.GuardianName</td>
                <td>@s.GuardianContact</td>
                <td class="text-end text-nowrap">
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-three-dots-vertical"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item" asp-action="Details" asp-route-id="@s.Id">
                                    <i class="bi bi-eye me-2"></i> View Details
                                </a>
                            </li>
                            @if (!User.IsInRole("Finance"))
                            {
                                <li>
                                    <a class="dropdown-item" asp-action="Edit" asp-route-id="@s.Id">
                                        <i class="bi bi-pencil me-2"></i> Edit
                                    </a>
                                </li>
                            }
                            @if (User.IsInRole("Admin"))
                            {
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline" data-confirm="Delete this student?">
                                        <button type="submit" class="dropdown-item text-danger" style="background:none; border:none; padding:0.25rem 1rem; text-align:left; width:100%;">
                                            <i class="bi bi-trash me-2"></i> Delete
                                        </button>
                                    </form>
                                </li>
                            }
                        </ul>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Items.Any())
{
    <p class="text-body-secondary text-center py-3">No students yet.</p>
}
else
{
    <!-- Pagination footer -->
    <partial name="_PaginationFooter" model='new PaginationFooterVM
    {
        Action = "Index",
        Page = Model.Page,
        PageSize = Model.PageSize,
        TotalCount = Model.TotalCount,
        AriaLabel = "Students pagination",
        RouteValues = new Dictionary<string, object?>
        {
            ["q"] = Model.Search,
            ["gradeId"] = Model.GradeLevelId
        }
    }' />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
